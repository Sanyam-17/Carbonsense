# --- security (required; the app warns in dev and refuses to start in production without them) ---
CARBONSENSE_ACCESS_PASSWORD=choose-a-long-password
CARBONSENSE_SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# node-id:key pairs, no ':' or ',' inside keys. Generate keys with: openssl rand -hex 24
CARBONSENSE_NODE_KEYS=room-node-01:change-me-dev-key,sim-bench-01:bench-dev-key
CARBONSENSE_NODE_ROOMS=room-node-01:room-204,sim-bench-01:room-204
# --- behaviour ---
CARBONSENSE_HOME_TZ=UTC
CARBONSENSE_SAMPLE_INTERVAL_S=5
CARBONSENSE_RETENTION_DAYS=7
# simulator: on in dev, off in production by default. Set "off" to disable.
CARBONSENSE_SIMULATOR=on
# --- carbon: no default on purpose. Set all three from a source you can cite; carbon stays "not calculated" until you do. ---
# CARBONSENSE_EF_KG_PER_KWH=
# CARBONSENSE_EF_SOURCE=
# CARBONSENSE_EF_VALID_FROM=2025-01-01
# --- storage ---
# CARBONSENSE_DB_URL=file:data/carbonsense.db
# CARBONSENSE_DATA_DIR=data
